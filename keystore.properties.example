# Copy to keystore.properties (git-ignored) to sign release builds.
# Create a key with:
#   keytool -genkeypair -keystore ~/.android-keys/kaggleruns-release.jks -storetype PKCS12 \
#           -alias kaggleruns -keyalg RSA -keysize 4096 -validity 10000
# Keep the .jks file and passwords outside the repo and back them up:
# losing them means you cannot ship updates over an installed app.
storeFile=/absolute/path/to/kaggleruns-release.jks
storePassword=change-me
keyAlias=kaggleruns
keyPassword=change-me
