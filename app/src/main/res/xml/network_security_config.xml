<?xml version="1.0" encoding="utf-8"?>
<!-- The token only ever travels over HTTPS; plain HTTP is refused outright. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
